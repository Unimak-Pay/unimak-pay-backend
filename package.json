{
  "name": "unimak-fees",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file=.env --watch-path=dist dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "channel": "tsx --env-file=.env scripts/channel.ts",
    "portal:event": "tsx --env-file=.env scripts/portal-event.ts",
    "openapi:models": "tsx scripts/openapi-models.ts",
    "openapi:lint": "npx -y @redocly/cli@1.34.3 lint openapi.yaml",
    "openapi:preview": "npx -y @redocly/cli@1.34.3 preview-docs openapi.yaml",
    "start:local": "tsc -p tsconfig.build.json && node --env-file=.env dist/src/main.js",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "monime:provision": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/cli/provision-accounts.js",
    "monime:balances": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/cli/balances.js",
    "monime:banks": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/cli/banks.js",
    "monime:register-webhook": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/cli/register-webhook.js",
    "monime:payout": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/cli/payout.js",
    "admin:create": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/cli/admin-create.js",
    "admin:login": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env --env-file-if-exists=.env.production.local dist/src/cli/admin-login.js",
    "ussd:flow": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/src/cli/ussd-flow.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test/unit"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
