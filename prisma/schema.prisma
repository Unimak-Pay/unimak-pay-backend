// UNIMAK fee collection — system of record for money.
// All money columns are BigInt in SLE minor units (1 SLE = 100). SLE only.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // rhel = Vercel Node runtime
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum PayerKind {
  APPLICANT
  STUDENT
}

enum Recurrence {
  ONCE
  PER_YEAR
}

enum Residency {
  LOCAL
  INTERNATIONAL
}

enum FeeStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ObligationStatus {
  OPEN
  PAID
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  REFUND
}

enum Channel {
  USSD
  DOTS
}

/// How Monime collects: a payment code we create, or the USSD flow's collect_payment template.
enum CollectionMethod {
  PAYMENT_CODE
  USSD_FLOW
}

enum PaymentStatus {
  INITIATED
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  SENT
  DEAD
}

// ───────────────────────────── Catalog ─────────────────────────────

model FeeType {
  id                String     @id @default(uuid()) @db.Uuid
  /// APP, MATRIC, TUITION, DEPT, GRAD or a custom code
  code              String     @unique
  name              String
  payerKind         PayerKind
  recurrence        Recurrence
  createdAt         DateTime   @default(now())

  fees    Fee[]
  /// Monime financial account collections for this fee type settle into
  account FinancialAccount?
}

model Fee {
  id                   String    @id @default(uuid()) @db.Uuid
  feeTypeId            String    @db.Uuid
  name                 String
  /// "2026/27" for academic-year fees, "2026-SEP" for intake-based fees
  period               String
  allowInstalments     Boolean   @default(false)
  defaultMinInstalment BigInt?
  dueDate              DateTime?
  status               FeeStatus @default(DRAFT)
  createdAt            DateTime  @default(now())

  feeType          FeeType           @relation(fields: [feeTypeId], references: [id])
  rateRules        RateRule[]
  instalmentRules  InstalmentRule[]
  eligibilityRules EligibilityRule[]
  obligations      Obligation[]

  @@unique([feeTypeId, period])
  @@index([status])
}

model RateRule {
  id          String     @id @default(uuid()) @db.Uuid
  feeId       String     @db.Uuid
  programCode String?
  department  String?
  level       Int?
  residency   Residency?
  intake      String?
  amount      BigInt
  createdAt   DateTime   @default(now())

  fee Fee @relation(fields: [feeId], references: [id])

  @@index([feeId])
}

/// Minimum instalment for one department's payers (overrides Fee.defaultMinInstalment).
model InstalmentRule {
  id            String   @id @default(uuid()) @db.Uuid
  feeId         String   @db.Uuid
  /// Department.code
  department    String
  minInstalment BigInt
  updatedBy     String
  updatedAt     DateTime @updatedAt

  fee Fee @relation(fields: [feeId], references: [id])

  @@unique([feeId, department])
}

model EligibilityRule {
  id          String     @id @default(uuid()) @db.Uuid
  feeId       String     @db.Uuid
  programCode String?
  department  String?
  level       Int?
  residency   Residency?
  intake      String?
  finalYear   Boolean?

  fee Fee @relation(fields: [feeId], references: [id])

  @@index([feeId])
}

model PricingConfig {
  id            String   @id @default(uuid()) @db.Uuid
  channel       Channel
  /// Total UNIMAK gives up, in basis points (250 = 2.5%)
  totalRateBps  Int
  /// Monime's share: percentage part (bps) + flat part (minor units)
  monimeRateBps Int      @default(0)
  monimeFlat    BigInt   @default(0)
  effectiveFrom DateTime

  payments Payment[]

  @@unique([channel, effectiveFrom])
}

// ───────────────────────────── Payers & obligations ─────────────────────────────

model Payer {
  id              String     @id @default(uuid()) @db.Uuid
  kind            PayerKind
  /// applicationRef for applicants, studentId for students
  ref             String
  fullName        String
  phone           String
  programCode     String
  department      String?
  level           Int?
  finalYear       Boolean?
  residency       Residency
  intake          String
  applicantStatus String?
  snapshotAt      DateTime

  obligations Obligation[]
  receipts    Receipt[]

  @@unique([kind, ref])
}

model Obligation {
  id        String           @id @default(uuid()) @db.Uuid
  payerId   String           @db.Uuid
  feeId     String           @db.Uuid
  /// copied from the best-matching rate rule at creation
  amount    BigInt
  rateRuleId String?         @db.Uuid
  status    ObligationStatus @default(OPEN)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  payer    Payer         @relation(fields: [payerId], references: [id])
  fee      Fee           @relation(fields: [feeId], references: [id])
  entries  LedgerEntry[]
  payments Payment[]
  receipts Receipt[]

  @@unique([payerId, feeId])
}

/// Append-only (UPDATE/DELETE blocked by trigger). Signed amount:
/// CHARGE > 0 (owed), PAYMENT < 0, REFUND > 0, ADJUSTMENT either way.
/// balance = SUM(amount).
model LedgerEntry {
  id           String          @id @default(uuid()) @db.Uuid
  obligationId String          @db.Uuid
  type         LedgerEntryType
  amount       BigInt
  paymentId    String?         @unique @db.Uuid
  memo         String?
  createdBy    String
  createdAt    DateTime        @default(now())

  obligation Obligation @relation(fields: [obligationId], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id])

  @@index([obligationId])
}

// ───────────────────────────── Payments ─────────────────────────────

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  obligationId    String        @db.Uuid
  amount          BigInt
  channel         Channel
  /// channel API client that created it (idempotency scope)
  clientId        String
  idempotencyKey  String
  /// short ref shown to the payer (8 digits) for status checks
  paymentRef      String        @unique
  /// number that actually paid: full when known (verified or from metadata),
  /// else Monime's masked one (+23276****56); null until known
  payerPhone      String?
  /// payment code restricted to payerPhone
  phoneAuthorized Boolean       @default(true)
  collectionMethod CollectionMethod @default(PAYMENT_CODE)
  status          PaymentStatus @default(INITIATED)
  /// Monime payment code id (pmc-…) created at initiation
  monimeRef       String?       @unique
  /// USSD string the payer dials, e.g. *715*1*7344331308#
  ussdCode        String?
  /// Monime Payment id (spm-…) from payment.processing_completed
  monimePaymentId String?       @unique
  /// Monime order number from the completed payment (sent to the payer by Monime SMS)
  monimeOrderNumber String?
  pricingConfigId String        @db.Uuid
  monimeFee       BigInt
  platformFee     BigInt
  netAmount       BigInt
  expiresAt       DateTime
  completedAt     DateTime?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  obligation    Obligation    @relation(fields: [obligationId], references: [id])
  pricingConfig PricingConfig @relation(fields: [pricingConfigId], references: [id])
  ledgerEntry   LedgerEntry?
  receipt       Receipt?

  @@unique([clientId, idempotencyKey])
  @@index([obligationId, status])
  @@index([status, expiresAt])
  @@index([monimeOrderNumber])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  UNMATCHED
  FAILED
}

/// Inbox for Monime webhook deliveries. The Monime event id is the dedupe key;
/// PROCESSED / IGNORED / UNMATCHED are final, FAILED is retried by Monime.
model WebhookEvent {
  id          String             @id @db.VarChar(100)
  type        String             @db.VarChar(100)
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  /// failure message or outcome note (e.g. why UNMATCHED)
  error       String?
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  /// set when an admin resolves an UNMATCHED / FAILED event (reconciliation)
  resolvedAt  DateTime?
  resolvedBy  String?            @db.Uuid
  resolution  String?

  @@index([status])
}

// ───────────────────────────── Receipts ─────────────────────────────

model Receipt {
  id           String   @id @default(uuid()) @db.Uuid
  /// UNIMAK-YYYY-NNNNNN
  number       String   @unique
  verifyCode   String   @unique
  paymentId    String   @unique @db.Uuid
  payerId      String   @db.Uuid
  obligationId String   @db.Uuid
  amount       BigInt
  issuedAt     DateTime @default(now())

  payment    Payment    @relation(fields: [paymentId], references: [id])
  payer      Payer      @relation(fields: [payerId], references: [id])
  obligation Obligation @relation(fields: [obligationId], references: [id])

  @@index([payerId])
}

model ReceiptCounter {
  year Int @id
  last Int @default(0)
}

// ───────────────────────────── Outbox ─────────────────────────────

model OutboxMessage {
  id            String       @id @default(uuid()) @db.Uuid
  /// sms.receipt | portal.application_paid | monime.commission_transfer
  type          String
  /// idempotency: e.g. "monime.commission_transfer:<paymentId>"
  dedupeKey     String       @unique
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lockedUntil   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

// ───────────────────────────── Monime accounts, transfers, payouts ─────────────────────────────

enum FinancialAccountPurpose {
  /// receives collections for one fee type (one account per service)
  FEE_TYPE
  /// the platform's own account (receives commission)
  PLATFORM
}

/// Mirror of a Monime financial account we provisioned.
model FinancialAccount {
  id               String                  @id @default(uuid()) @db.Uuid
  /// Monime id (fac-…)
  monimeId         String                  @unique
  /// our provisioning key, also Monime's (unique per Space) reference
  reference        String                  @unique
  name             String
  purpose          FinancialAccountPurpose
  feeTypeId        String?                 @unique @db.Uuid
  uvan             String?
  /// last known available balance (minor units) from Monime
  availableBalance BigInt?
  balanceUpdatedAt DateTime?
  createdAt        DateTime                @default(now())

  feeType FeeType? @relation(fields: [feeTypeId], references: [id])
  payouts Payout[]
}

enum TransferStatus {
  /// recorded, not yet accepted by Monime
  PENDING
  /// accepted by Monime (pending/processing there)
  SUBMITTED
  COMPLETED
  FAILED
}

/// Internal transfer between our Monime accounts (platform commission per payment).
model Transfer {
  id                 String         @id @default(uuid()) @db.Uuid
  kind               String // COMMISSION
  paymentId          String?        @unique @db.Uuid
  sourceAccount      String
  destinationAccount String
  amount             BigInt
  status             TransferStatus @default(PENDING)
  /// 1 for the first send; an admin retry after FAILED increments it (new Idempotency-Key)
  attempt            Int            @default(1)
  monimeTransferId   String?        @unique
  failureCode        String?
  failureMessage     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  completedAt        DateTime?

  @@index([status])
}

enum PayoutStatus {
  /// recorded, not yet accepted by Monime
  REQUESTED
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
}

/// Withdrawal from one of our Monime accounts to a bank (or momo) account.
model Payout {
  id                 String       @id @default(uuid()) @db.Uuid
  financialAccountId String       @db.Uuid
  amount             BigInt
  destinationType    String // bank | momo
  providerId         String
  /// bank account number (or MSISDN for momo)
  accountNumber      String
  accountName        String?
  narration          String?
  status             PayoutStatus @default(REQUESTED)
  monimePayoutId     String?      @unique
  /// Monime fees reported on the payout
  fees               BigInt?
  failureCode        String?
  failureMessage     String?
  requestedBy        String
  idempotencyKey     String       @unique
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  completedAt        DateTime?

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])

  @@index([financialAccountId, status])
}

// ───────────────────────────── Faculties & departments ─────────────────────────────

/// A faculty (or a grouping such as Postgraduate Studies). Codes never change.
model Faculty {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
}

/// A department. `code` is what the portal sends as the payer's department and
/// what rules, heads of department and payer snapshots store (as text).
model Department {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  /// null only while it needs review
  facultyId   String?  @db.Uuid
  active      Boolean  @default(true)
  /// Seen from the portal but not set up by an admin yet (name = code, no faculty)
  needsReview Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  faculty Faculty? @relation(fields: [facultyId], references: [id])

  @@index([facultyId])
}

// ───────────────────────────── Admin users & audit ─────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  BURSAR
  FINANCE_OFFICER
  HEAD_OF_DEPARTMENT
  DEAN
  AUDITOR
}

/// Invite-only: a Supabase Auth user can use the admin API only if an active
/// AdminUser with their email exists. Bound to the Supabase user id on first login.
model AdminUser {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  /// Supabase Auth user id (JWT sub), set on first login
  authUserId       String?   @unique @db.Uuid
  name             String?
  role             AdminRole
  /// granted on top of the role's bundle (e.g. instalments.manage)
  extraPermissions String[]  @default([])
  /// HEAD_OF_DEPARTMENT scope (Department.code)
  departments      String[]  @default([])
  /// DEAN scope (Faculty.code): every department of these faculties
  faculties        String[]  @default([])
  active           Boolean   @default(true)
  lastLoginAt      DateTime?
  createdBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Every admin write, with before/after values.
model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  /// AdminUser id, or "cli:<user>" / "system"
  actorId  String
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, at])
}

// ───────────────────────────── Reconciliation ─────────────────────────────

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

/// One nightly (or manual) comparison of a time window against Monime.
model ReconciliationRun {
  id          String                  @id @default(uuid()) @db.Uuid
  windowStart DateTime
  windowEnd   DateTime
  status      ReconciliationRunStatus @default(RUNNING)
  /// "cron" or an AdminUser id
  triggeredBy String
  startedAt   DateTime                @default(now())
  finishedAt  DateTime?
  stats       Json?
  error       String?

  items ReconciliationItem[]

  @@index([windowStart, status])
}

enum ReconciliationItemStatus {
  /// needs a human
  OPEN
  /// fixed by the run itself (e.g. a missed webhook settled)
  AUTO_RESOLVED
  /// closed by an admin
  RESOLVED
}

model ReconciliationItem {
  id              String                   @id @default(uuid()) @db.Uuid
  runId           String                   @db.Uuid
  /// MISSED_WEBHOOK_SETTLED | UNMATCHED_MONIME_PAYMENT | MISSING_AT_MONIME |
  /// AMOUNT_MISMATCH | MONIME_FEE_MISMATCH | COMMISSION_MISSING |
  /// COMMISSION_NOT_COMPLETED | COMMISSION_AMOUNT_MISMATCH | SCAN_TRUNCATED
  kind            String
  status          ReconciliationItemStatus @default(OPEN)
  paymentId       String?                  @db.Uuid
  monimePaymentId String?
  transferId      String?                  @db.Uuid
  financialAccountId String?
  expected        Json?
  actual          Json?
  note            String
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?
  createdAt       DateTime                 @default(now())

  run ReconciliationRun @relation(fields: [runId], references: [id])

  @@index([status, kind])
  @@index([paymentId])
  @@index([monimePaymentId])
}

// ───────────────────────────── USSD sessions ─────────────────────────────

/// Server-side state of a Monime USSD flow session. The flow's own flowData is
/// untrusted input; what the subscriber may do next is decided from this row.
model UssdSession {
  /// Monime global.sessionId
  id           String   @id @db.VarChar(100)
  /// Monime global.subscriberId (uuidv5 of the MSISDN)
  subscriberId String   @db.VarChar(100)
  state        Json
  lookups      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subscriberId, createdAt])
}

// ───────────────────────────── Dev-only mocks ─────────────────────────────

/// Backs MockMonimeClient (MONIME_MODE=mock). Unused in http mode.
model MockMonimeRecord {
  id        String   @id
  kind      String // COLLECTION | TRANSFER
  status    String
  amount    BigInt
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
