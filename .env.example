NODE_ENV=development
PORT=3100
PUBLIC_BASE_URL=http://localhost:3100

# Supabase: DATABASE_URL = transaction pooler, DIRECT_URL = direct connection (migrations)
# DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Local (docker compose):
DATABASE_URL="postgresql://unimak:unimak@localhost:54329/unimak"
DIRECT_URL="postgresql://unimak:unimak@localhost:54329/unimak"

# Portal: mock reads fixtures/portal/*.json; http calls the real portal (1.5 s timeout)
PORTAL_MODE=mock
PORTAL_MOCK_LATENCY_MS=150
PORTAL_FIXTURES_DIR=fixtures/portal
# PORTAL_BASE_URL=https://portal.unimak.edu.sl/api
# PORTAL_API_KEY=

# Monime: mock records collections in the MockMonimeRecord table
MONIME_MODE=mock
# MONIME_BASE_URL=https://api.monime.io/v1
# MONIME_API_VERSION=caph.2025-08-23
# MONIME_ACCESS_TOKEN=
# MONIME_SPACE_ID=
# Webhook signature: Monime-Signature: t=<ts>,v1=<base64 HMAC-SHA256(secret, "<t>_" + raw body)>
# MONIME_WEBHOOK_TOLERANCE_SECONDS=300
MONIME_WEBHOOK_SECRET=change-me-webhook-secret-0123456789
PLATFORM_MONIME_ACCOUNT=fa-platform-commission

# Channel API clients (API key + HMAC secret per channel)
CHANNEL_CLIENTS='[{"id":"ussd","apiKey":"dev-ussd-key","secret":"dev-ussd-secret-0123456789"},{"id":"dots","apiKey":"dev-dots-key","secret":"dev-dots-secret-0123456789"}]'

CRON_SECRET=change-me-cron-secret-0123456789
PAYMENT_EXPIRY_MINUTES=15
OUTBOX_DISPATCH_INLINE=true
