{
  "version": "1.0",
  "description": "UNIMAK fee payments. Every page calls the UNIMAK exchange endpoint, which decides the next page. Generated by pnpm ussd:flow.",
  "pages": [
    {
      "id": "start",
      "component": {
        "type": "dynamic",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "main_menu",
      "component": {
        "type": "menu",
        "label": "$(data.message)",
        "items": "$(data.items)"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "id_type",
      "component": {
        "type": "menu",
        "label": "$(data.message)",
        "items": "$(data.items)"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "enter_id",
      "component": {
        "type": "prompt",
        "label": "$(data.message)",
        "data_type": "text"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "confirm_payer",
      "component": {
        "type": "menu",
        "label": "$(data.message)",
        "items": "$(data.items)"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "select_fee",
      "component": {
        "type": "menu",
        "label": "$(data.message)",
        "items": "$(data.items)"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "enter_amount",
      "component": {
        "type": "prompt",
        "label": "$(data.message)",
        "data_type": "number"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "confirm_amount",
      "component": {
        "type": "menu",
        "label": "$(data.message)",
        "items": "$(data.items)"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "share_number",
      "component": {
        "type": "template",
        "template_name": "get_subscriber_msisdn"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}",
        "dataExport": {
          "phone_number": "$(page.share_number.value)"
        }
      }
    }
  ]
}
