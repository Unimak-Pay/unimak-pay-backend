{
  "version": "1.0",
  "pages": [
    {
      "id": "home",
      "component": {
        "label": "UNIMAK Payments\nWhat would you like to do?",
        "type": "menu",
        "items": [
          {
            "label": "Pay a fee",
            "value": "pay"
          },
          {
            "label": "Check balance",
            "value": "balance"
          },
          {
            "label": "Resend last receipt",
            "value": "resend"
          },
          {
            "label": "Help",
            "value": "help"
          }
        ]
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "id_type",
      "component": {
        "label": "Find your record by",
        "type": "menu",
        "items": [
          {
            "label": "Student ID",
            "value": "student"
          },
          {
            "label": "Application No.",
            "value": "applicant"
          }
        ]
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "enter_student_id",
      "component": {
        "type": "prompt",
        "label": "Enter your Student ID, e.g. UNI-2025-0002",
        "data_type": "text",
        "min_length": 3,
        "max_length": 32,
        "max_invalid_input_attempts": 3
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "enter_application_ref",
      "component": {
        "type": "prompt",
        "label": "Enter your Application No., e.g. APP-2026-0001",
        "data_type": "text",
        "min_length": 3,
        "max_length": 32,
        "max_invalid_input_attempts": 3
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "try_again",
      "component": {
        "label": "$(data.message)",
        "type": "menu",
        "items": [
          {
            "label": "Try again",
            "value": "retry"
          },
          {
            "label": "Cancel",
            "value": "cancel"
          }
        ]
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "confirm_payer",
      "component": {
        "label": "$(data.payer_name)\n$(data.program_line)",
        "type": "menu",
        "items": [
          {
            "label": "Continue",
            "value": "continue"
          },
          {
            "label": "Cancel",
            "value": "cancel"
          }
        ]
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "select_fee",
      "component": {
        "label": "Select a fee",
        "type": "menu",
        "items": "$(data.fees)"
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "enter_amount",
      "component": {
        "type": "prompt",
        "label": "$(data.fee_name)\nEnter amount in SLE\n(min $(data.min_display), max $(data.max_display))",
        "data_type": "text",
        "min_length": 1,
        "max_length": 12,
        "max_invalid_input_attempts": 3
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "confirm_payment",
      "component": {
        "label": "$(data.payer_name)\n$(data.fee_name)\nPay: $(data.amount_display)",
        "type": "menu",
        "items": [
          {
            "label": "Confirm and pay",
            "value": "confirm"
          },
          {
            "label": "Cancel",
            "value": "cancel"
          }
        ]
      },
      "on_done": {
        "action": "exchange",
        "url": "{{EXCHANGE_URL}}"
      }
    },
    {
      "id": "make_payment",
      "component": {
        "type": "template",
        "template_name": "collect_payment",
        "label": "Enter your $(session.network_provider_name) PIN to pay $(data.amount_display) for $(data.fee_name).",
        "template_data": {
          "amount": "$(data.amount)",
          "payment_target_ref": "$(data.payment_target_ref)",
          "reference": "$(data.reference)",
          "receipt_name": "$(data.receipt_name)",
          "metadata": {
            "payment_id": "$(data.payment_id)",
            "financial_account_id": "$(data.financial_account_id)"
          }
        }
      },
      "on_done": {
        "action": "next",
        "next_page": "payment_started"
      }
    },
    {
      "id": "payment_started",
      "component": {
        "label": "$(data.payment_message)\nRef: $(data.payment_ref)",
        "type": "display"
      }
    },
    {
      "id": "payment_cancelled",
      "component": {
        "label": "Payment cancelled. Nothing was charged.\nThank you for using UNIMAK Payments.",
        "type": "display"
      }
    }
  ]
}
